# Copy to .env for local development. Everything here is optional: with no values set, the
# stack runs on in-memory stores and the deterministic mock LLM provider.

# --- LLM (§25) ---------------------------------------------------------------
# Absent by default. When set, GeminiProvider activates and the eval suites run against the
# real model. Model IDs are configuration, not code, so an upgrade is a staged rollout.
# GOOGLE_API_KEY=
# WOOHOO_LLM_MODEL=gemini-2.5-flash

# --- Datastores (§36) --------------------------------------------------------
# DATABASE_URL=postgres://woohoo:woohoo@localhost:5432/woohoo
# REDIS_URL=redis://localhost:6379
# NATS_URL=nats://localhost:4222

# --- Services ----------------------------------------------------------------
# PORT=8443
# WOOHOO_PROPERTY_ID=p_blr_whitefield

# --- Never put these here ----------------------------------------------------
# Per-property BMS and PMS credentials belong in Secrets Manager, scoped individually and
# rotated individually. A shared credential across properties turns one hotel's incident into
# all of them (§54).
