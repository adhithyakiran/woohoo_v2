# Copy to .env and fill in. Nothing here is read unless the file is named .env
#
# The stack runs with NONE of these set: the agent falls back to a deterministic mock
# provider and an in-process room simulator, and every lane, policy rule and console
# panel still works. Set them to move onto the real model and a real head-end.

# --- model -------------------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=20

# --- room automation ---------------------------------------------------------
# honeywell = talk to a head-end over HTTP. Unset = in-process simulator.
WOOHOO_ADAPTER=honeywell
HONEYWELL_URL=http://mock-honeywell:8091

# --- control plane -----------------------------------------------------------
# Guards POST /v1/admin/rooms, which can bind a device to any room. Leave blank and
# one is generated per run and printed at startup.
WOOHOO_ADMIN_TOKEN=

# Hand room/device records to another service. Blank uses the built-in catalog.
WOOHOO_CATALOG_URL=
