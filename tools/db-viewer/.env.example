# Copy to .env and fill in. The app refuses to start without the three SOURCE_DB_*
# values marked required; everything else has a working default.

# --- the database being browsed (read-only) ----------------------------------
SOURCE_DB_HOST=            # required, e.g. mydb.abc123.us-west-2.rds.amazonaws.com
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=postgres
SOURCE_DB_USER=            # required
SOURCE_DB_PASSWORD=        # required
# SSL is on by default (RDS requires it). Set to `off` for a plain local server.
SOURCE_DB_SSL=

# --- where "replicate to local" writes ---------------------------------------
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5433
TARGET_DB_NAME=masterdb
TARGET_DB_USER=postgres
TARGET_DB_PASSWORD=postgres

# --- the throwaway local Postgres this app can start for you ------------------
LOCAL_PG_CONTAINER=woohoo-db-local
LOCAL_PG_IMAGE=postgres:16-alpine

# --- server -------------------------------------------------------------------
HOST=127.0.0.1
PORT=4180
QUERY_TIMEOUT_MS=30000
