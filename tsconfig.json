{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@woohoo/contracts": ["packages/contracts/src/index.ts"],
      "@woohoo/contracts/*": ["packages/contracts/src/*"],
      "@woohoo/otel": ["packages/otel/src/index.ts"],
      "@woohoo/policy": ["services/policy-service/src/index.ts"],
      "@woohoo/policy/*": ["services/policy-service/src/*"],
      "@woohoo/core": ["services/woohoo-core/src/index.ts"],
      "@woohoo/core/*": ["services/woohoo-core/src/*"],
      "@woohoo/adapter-simulator": ["services/adapter-simulator/src/index.ts"],
      "@woohoo/edge-gateway": ["services/edge-gateway/src/index.ts"],
      "@woohoo/device-gateway": ["services/device-gateway/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "services/**/*.ts", "tools/**/*.ts", "eval/**/*.ts"],
  "exclude": ["node_modules", "dist", "docs"]
}
